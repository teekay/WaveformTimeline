<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:WaveformTimelineDemo.Avalonia"
        xmlns:wf="using:WaveformTimeline"
        x:Class="WaveformTimelineDemo.Avalonia.MainWindow"
        x:DataType="local:ViewModel"
        Title="WaveformTimeline Demo (Avalonia)"
        Height="450"
        Width="800">
    <Window.DataContext>
        <local:ViewModel />
    </Window.DataContext>
    <Grid>
        <StackPanel Margin="5,20,5,0"
                    VerticalAlignment="Top">
            <TextBlock Text="{Binding Title, FallbackValue='No track'}"
                       Margin="0,0,0,20"
                       FontSize="24"
                       HorizontalAlignment="Center" />
            <wf:WaveformTimeline Tune="{Binding Tune}"
                                 CueBarBackgroundBrush="Black"
                                 ProgressBarBrush="Red"
                                 ProgressBarThickness="2"
                                 AllowRepositioning="False"
                                 Height="120"
                                 Zoom="1"
                                 WaveformResolution="8000"
                                 TimelineType="Constant"
                                 ProgressiveRendering="True" />
            <Grid Margin="5" ColumnDefinitions="2*,Auto,Auto,Auto">
                <Button Grid.Column="0"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenFile}">Load audio file</Button>
                <Button Grid.Column="1"
                        Margin="0,20,0,0"
                        Width="50"
                        HorizontalAlignment="Center"
                        Command="{Binding Play}">Play</Button>
                <Button Grid.Column="2"
                        Margin="10,20,0,0"
                        Width="50"
                        HorizontalAlignment="Center"
                        Command="{Binding Pause}">Pause</Button>
                <Button Grid.Column="3"
                        Margin="10,20,0,0"
                        Width="50"
                        HorizontalAlignment="Center"
                        Command="{Binding Stop}">Stop</Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
